# NarrativePulse Environment Variables
# Copy this file to .env and fill in your actual values

# ===========================================
# FRONTEND CONFIGURATION (Vite)
# ===========================================

# API URL - Points to the NarrativePulse backend
VITE_API_URL=http://localhost:3001/api

# Third-party Services (optional)
# VITE_ANALYTICS_ID=your_analytics_id
# VITE_SENTRY_DSN=your_sentry_dsn

# Feature Flags
VITE_ENABLE_DEMO=true
VITE_ENABLE_ANALYTICS=false

# ===========================================
# BACKEND CONFIGURATION (see backend/.env.example for full backend config)
# ===========================================

# Quick reference - see backend/.env.example for complete list:
# - DATABASE_URL: PostgreSQL connection string
# - ANTHROPIC_API_KEY: For AI narrative generation
# - GOOGLE_AI_API_KEY: For Nano Banana Pro visual generation
# - JWT_SECRET: For authentication
